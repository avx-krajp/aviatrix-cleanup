# This project doesn't read a .env file at runtime — configuration is passed
# via SAM `--parameter-overrides` (see docs/DEPLOYMENT.md and setup/deploy.sh).
# This file documents what each parameter needs so you can prepare values
# before running the guided deploy.

# StageName — API Gateway stage name. Leave as "prod" unless you have a reason to change it.
StageName=prod

# AzureSpSecretArn — ARN of a Secrets Manager secret containing:
#   {"tenantId": "...", "clientId": "...", "clientSecret": "...", "subscriptionId": "..."}
# Leave blank to disable Azure cleanup and Azure instance support.
AzureSpSecretArn=

# GcpSaSecretArn — ARN of a Secrets Manager secret containing the full JSON
# key file for a GCP service account (downloaded from IAM & Admin > Service
# Accounts > Keys). Leave blank to disable GCP cleanup and instance support.
GcpSaSecretArn=

# AzureSdkLayerArn — ARN of a pre-built Lambda layer with the azure-mgmt-*/
# azure-identity packages. See docs/AZURE_LAYER.md to build one. Leave blank
# if you're not using Azure.
AzureSdkLayerArn=

# LoginPassword — passphrase for the web app's login page. Min 12 characters.
LoginPassword=

# AuthSigningKey — HMAC signing key for the auth cookie. Generate with:
#   openssl rand -hex 32
AuthSigningKey=
